{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.checksumFailure.continue": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als fehlgeschlagen markieren und fortfahren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as failed and continue"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar como fallido y continuar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer comme échec et continuer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗としてマークして続行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패로 표시하고 계속"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记失败但继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記失敗但繼續"
          }
        }
      }
    },
    "action.checksumFailure.markOnly": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur als fehlgeschlagen markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as failed only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo marcar como fallido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer comme échec uniquement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗としてマークのみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패로만 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅标记失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅標記失敗"
          }
        }
      }
    },
    "action.checksumFailure.retry": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als fehlgeschlagen markieren und erneut übertragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as failed and retry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar como fallido y reintentar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer comme échec et réessayer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗としてマークして再転送"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패로 표시하고 재전송"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记失败并重新传输"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記失敗並重新傳輸"
          }
        }
      }
    },
    "app.placeholder": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberfläche wird in einer späteren Version implementiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interface will be implemented in a later release"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interfaz se implementará en una versión posterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'interface sera implémentée dans une version ultérieure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面は今後のリリースで実装されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스는 향후 버전에서 구현됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面将在后续迭代中实现"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面將在後續版本中實作"
          }
        }
      }
    },
    "app.subtitle": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Natives Dateikopier-Verwaltungswerkzeug für macOS"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A native macOS file copy manager"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestor nativo de copia de archivos para macOS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionnaire de copie de fichiers natif pour macOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ネイティブのファイルコピー管理ツール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 네이티브 파일 복사 관리 도구"
          }
        },
        "zh-Hans": {
          "stringUnit": {
