    "error.cancelled": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang wurde abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation was cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación se canceló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération a été annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作はキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 취소되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已取消。"
          }
        }
      }
    },
    "error.checksumMismatch": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfung von „%@\" fehlgeschlagen: Die %@-Prüfsumme stimmt nicht überein (erwartet %@, erhalten %@). Die Daten könnten beschädigt sein; sie werden automatisch erneut übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification failed for \"%@\": the %@ digest does not match (expected %@, got %@). The data may have been corrupted during transfer; it will be transferred once more automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la verificación de «%@»: el resumen %@ no coincide (esperado %@, obtenido %@). Los datos podrían haberse dañado; se transferirán automáticamente una vez más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la vérification de « %@ » : l'empreinte %@ ne correspond pas (attendu %@, obtenu %@). Les données ont pu être corrompues ; un nouvel envoi automatique sera effectué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の %@ 検証に失敗しました（期待値 %@、実際 %@）。転送中に資料が破損した可能性があるため、自動的に再転送します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"의 %@ 검증에 실패했습니다(예상 %@, 실제 %@). 전송 중 데이터가 손상되었을 수 있어 자동으로 한 번 더 전송합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校验失败：「%@」的 %@ 摘要不一致（期望 %@，实际 %@）。数据在传输中可能已损坏，将自动重新传输一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "校驗失敗：「%@」的 %@ 摘要不一致（預期 %@，實際 %@）。資料在傳輸中可能已損壞，將自動重新傳輸一次。"
          }
        }
      }
    },
    "error.cloneFailed": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@\" konnte nicht per APFS-Klon kopiert werden (%@); automatisch auf eine Standardkopie umgestellt. Das Ergebnis ist unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not clone \"%@\" using APFS (%@); automatically switched to a standard copy. The result is unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo clonar «%@» con APFS (%@); se cambió automáticamente a una copia estándar. El resultado no se ve afectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de cloner « %@ » avec APFS (%@) ; bascule automatique vers une copie standard. Le résultat n'est pas affecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を APFS 克隆で複製できませんでした（%@）。通常のコピーに自動で切り替えました。結果に影響はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"을 APFS 클론으로 복사할 수 없습니다(%@). 일반 복사로 자동 전환했으며 결과에는 영향이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用 APFS 克隆方式复制「%@」（%@），已自动切换为常规复制方式，不影响结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用 APFS 克隆方式複製「%@」（%@），已自動切換為一般複製方式，不影響結果。"
          }
        }
      }
    },
    "error.destinationUnwritable": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@\" kann nicht beschrieben werden. Prüfen Sie, ob der Zielordner vorhanden und beschreibbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot write to \"%@\". Check that the destination folder exists and is writable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede escribir en «%@». Compruebe que la carpeta de destino existe y tiene permisos de escritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'écrire dans « %@ ». Vérifiez que le dossier de destination existe et est accessible en écriture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に書き込めません。宛先フォルダーが存在し、書き込み権限があるか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"에 쓸 수 없습니다. 대상 폴더가 존재하고 쓰기 권한이 있는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入目标「%@」。请检查目标目录是否存在以及写入权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入目標「%@」。請檢查目標資料夾是否存在以及寫入權限。"
          }
        }
      }
    },
    "error.diskFull": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genügend Speicherplatz: %@ benötigt, %@ verfügbar. Geben Sie Speicher frei und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough disk space: %@ required, %@ available. Free some space and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio en disco insuficiente: se necesitan %@, hay %@ disponibles. Libere espacio e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace disque insuffisant : %@ nécessaires, %@ disponibles. Libérez de l'espace et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク容量が不足しています：必要 %@、利用可能 %@。空き容量を確保して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 공간이 부족합니다: 필요 %@, 사용 가능 %@. 공간을 확보한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标磁盘空间不足：还需 %@，可用 %@。请清理空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標磁碟空間不足：還需 %@，可用 %@。請清理空間後重試。"
          }
        }
      }
    },
    "error.fileBusy": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei „%@\" wird von einer anderen Anwendung verwendet. Schließen Sie diese und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file \"%@\" is in use by another application. Close it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo «%@» está en uso por otra aplicación. Ciérrela e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier « %@ » est utilisé par une autre application. Fermez-la et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル「%@」は他のアプリで使用中です。閉じてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 파일이 다른 앱에서 사용 중입니다. 종료한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件「%@」正被其他程序占用，无法读取。请关闭占用它的程序后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案「%@」正被其他程式占用，無法讀取。請關閉占用它的程式後重試。"
          }
        }
      }
    },
    "error.networkUnavailable": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerk nicht verfügbar; „%@\" (%@) ist nicht erreichbar. Prüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network unavailable; cannot reach \"%@\" (%@). Check the connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red no disponible; no se puede acceder a «%@» (%@). Compruebe la conexión e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réseau indisponible ; impossible d'atteindre « %@ » (%@). Vérifiez la connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに接続できません：「%@」（%@）。接続を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크를 사용할 수 없습니다: \"%@\"(%@). 연결을 확인한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络不可用，无法访问「%@」（%@）。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路不可用，無法存取「%@」（%@）。請檢查網路連線後重試。"
          }
        }
      }
    },
    "error.pathTooLong": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pfad ist %d Byte lang und überschreitet das macOS-Limit von 1024 Byte; „%@\" ist nicht erreichbar. Kürzen Sie die Ordnernamen und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The path is %d bytes long, exceeding the macOS limit of 1024 bytes; cannot access \"%@\". Shorten the directory names and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta tiene %d bytes y supera el límite de 1024 bytes de macOS; no se puede acceder a «%@». Acorte los nombres de carpeta e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin mesure %d octets et dépasse la limite macOS de 1024 octets ; impossible d'accéder à « %@ ». Raccourcissez les noms de dossiers et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パス長が %d バイトで、macOS の上限 1024 バイトを超えています：「%@」。ディレクトリ名を短くして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로 길이가 %d바이트로 macOS 제한 1024바이트를 초과했습니다: \"%@\". 폴더 이름을 줄인 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路径长度 %d 字节超出 macOS 限制（1024 字节），无法访问「%@」。请缩短目录名后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路徑長度 %d 位元組超出 macOS 限制（1024 位元組），無法存取「%@」。請縮短目錄名稱後重試。"
          }
        }
      }
    },
    "error.permissionDenied": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Leseberechtigung für „%@\". Erteilen Sie MacCopy in Systemeinstellungen → Datenschutz & Sicherheit den Vollzugriff auf die Festplatte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No permission to read \"%@\". Grant MacCopy Full Disk Access in System Settings → Privacy & Security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso de lectura para «%@». Conceda a MacCopy Acceso completo al disco en Ajustes del Sistema → Privacidad y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation de lecture manquante pour « %@ ». Accordez à MacCopy l'accès complet au disque dans Réglages Système → Confidentialité et sécurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を読み取る権限がありません。「システム設定 → プライバシーとセキュリティ → フルディスクアクセス」で MacCopy を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"을 읽을 권한이 없습니다. 시스템 설정 → 개인정보 보호 및 보안 → 전체 디스크 접근 권한에서 MacCopy를 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有权限读取「%@」。请在「系统设置 → 隐私与安全性 → 完全磁盘访问权限」中授权 MacCopy。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有權限讀取「%@」。請在「系統設定 → 隱私權與安全性 → 完整磁碟存取權限」中授權 MacCopy。"
          }
        }
      }
    },
    "error.sourceChangedDuringCopy": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelldatei „%@\" wurde während des Kopierens geändert. Um eine beschädigte Datei zu vermeiden, wurde der Vorgang abgebrochen. Bitte starten Sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source file \"%@\" changed during copying. To avoid a damaged file, this copy was stopped. Please start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de origen «%@» cambió durante la copia. Para evitar un archivo dañado se detuvo la copia. Vuelva a empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier source « %@ » a changé pendant la copie. Pour éviter tout fichier corrompu, la copie a été interrompue. Veuillez recommencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー中にソースファイル「%@」が変更されました。破損を避けるためコピーを中止しました。最初からやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사 중 원본 파일 \"%@\"이 변경되었습니다. 손상을 방지하기 위해 복사를 중단했습니다. 다시 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制过程中源文件「%@」发生了变化。为避免产生损坏的文件，本次复制已中止，请重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製過程中來源檔案「%@」發生了變化。為避免產生損壞的檔案，本次複製已中止，請重新開始。"
          }
        }
      }
    },
