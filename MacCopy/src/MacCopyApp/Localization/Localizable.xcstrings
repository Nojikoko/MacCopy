    "ui.settings.verify.hint": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quell- und Zielprüfsummen werden je Algorithmus verglichen. Ist die Quelle nicht positionierbar und nicht zurücklesbar, wird das Ergebnis ausdrücklich als nicht gehasht markiert statt stillschweigend zu bestehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source and destination digests are compared per algorithm. If the source is not seekable and cannot be read back, the result is clearly marked as not content-hashed instead of silently passing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resúmenes de origen y destino se comparan por algoritmo. Si el origen no es direccionable y no se puede releer, el resultado se marca explícitamente como sin hash en lugar de aprobarse en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les empreintes source et destination sont comparées par algorithme. Si la source n'est pas adressable et ne peut être relue, le résultat est explicitement marqué comme non haché, sans succès silencieux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースと宛先のダイジェストをアルゴリズムごとに比較します。ソースがシーク不可で読み戻せない場合、黙って合格とせず「内容ハッシュ未実施」と明記します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본과 대상 다이제스트를 알고리즘별로 비교합니다. 원본이 탐색 불가능하고 재읽기도 불가능하면 조용히 통과시키지 않고 \"콘텐츠 해시 미수행\"으로 명시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源与目标摘要逐算法比对。若源不可寻址且无法回读，会明确标注「未做内容哈希」，不会静默通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源與目標摘要逐演算法比對。若來源不可定址且無法回讀，會明確標注「未做內容雜湊」，不會靜默通過。"
          }
        }
      }
    },
