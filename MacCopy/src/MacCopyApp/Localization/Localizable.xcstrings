    "ui.queue.hint": {
      "comment": "v1.1 八语言（translations/*.json 为唯一译文事实源）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben werden beim Anlegen in eine persistente Warteschlange geschrieben. Nach unerwartetem Beenden können Sie hier fortsetzen; unfertige Dateien nutzen .maccopy.partial-Prüfpunkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks are written to a persistent queue when created. If the app quits unexpectedly, you can resume here next time; unfinished files use .maccopy.partial checkpoints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas se escriben en una cola persistente al crearse. Si la app se cierra inesperadamente, puede reanudar aquí; los archivos incompletos usan puntos de control .maccopy.partial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches sont écrites dans une file persistante à leur création. Après une fermeture inattendue, vous pouvez reprendre ici ; les fichiers inachevés utilisent les points de reprise .maccopy.partial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクは作成時に永続キューへ書き込まれます。予期せず終了した場合、次回起動時にここから再開できます。未完了ファイルは .maccopy.partial で断点続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업은 생성 시 영구 큐에 기록됩니다. 앱이 예기치 않게 종료되면 다음 실행 시 여기서 재개할 수 있으며, 미완료 파일은 .maccopy.partial 체크포인트로 이어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务在创建时写入持久化队列。若应用意外退出，下次打开可从这里继续；未完成的文件通过 .maccopy.partial 断点续传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務在建立時寫入持久化佇列。若應用程式意外結束，下次開啟可從這裡繼續；未完成的檔案透過 .maccopy.partial 斷點續傳。"
          }
        }
      }
    },
